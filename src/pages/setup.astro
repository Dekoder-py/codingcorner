---
import Layout from "../layouts/Layout.astro";
import "../styles/setup.css";
import GearComponent from "../components/GearComponent.astro";
---

<Layout title="My Stuff | Coding Corner">
  <h1>Things I use</h1>
  <p>
    I use a lot of stuff and if you for some reason want to know what stuff then
    you're in the right place
  </p>
  <br />

  <h2>Hardware / Tools (and a few other physical things)</h2>
  <div id="gear-grid">
  <GearComponent title="M5 MacBook Pro (16GB RAM, 1TB SSD)" />
  <GearComponent title="Raspberry Pi 5, 8GB" desc="(Home Assistant)" />
  <GearComponent
    title="Raspberry Pi 5, 8GB"
    desc="(Docker stuff like Slack Annoyance)"
  />
  <GearComponent title="MX Master 3S" />
  <GearComponent title="Keychron V1 ANSI w/ Rotary Encoder" />
  <GearComponent title="iPhone 16e" />
  <GearComponent title="BLAHAJ (55 cm / smolhaj)" />
  <GearComponent title="Dingbats* A6 Hardcover Notebook" />
  </div>

  <br />

  <h2>Software</h2>
  <div id="gear-grid">
  <GearComponent title="Neovim" desc="Yes, I build from source" />
  <GearComponent title="Rust" desc="... I use Rust btw" />
  <GearComponent title="Ghostty" />
  <GearComponent title="Helium Browser" />
  <GearComponent title="Slack" desc="(for Hack Club + slacking)" />
  <GearComponent title="tmux" />
  <GearComponent title="Tidal" />
  </div>
</Layout>
