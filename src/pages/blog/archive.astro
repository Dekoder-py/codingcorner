---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allPosts = (await getCollection("archive")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Coding Corner Blog Archive">
  <h1 class="mb-4">Blog Archive</h1>

  <p class="font-bold text-md">Note: Posts on this page are archived, so they may not (and probably aren't) up to date or correct.</p>

  <br />

  <ul class="leading-relaxed">
    {
      allPosts.map((post) => (
        <li>
          <a href={`/posts/archive/${post.id}/`}>{post.data.title} </a>
          <span class="text-ctp-text"> {"\u203a"} </span>
          <span class="text-ctp-subtext0">
            {" "}
            Published on {post.data.pubDate.toLocaleDateString()}
          </span>
        </li>
      ))
    }
  </ul>
</Layout>
