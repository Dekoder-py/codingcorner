---
import Layout from "../layouts/Layout.astro";

import "../styles/index.css";

import Webrings from "../components/Webrings.astro";
import Buttons from "../components/Buttons.astro";
---

<Layout>
  <h1>Hey there!</h1>
  <p>
    I'm Kyle, a 16 year old developer, coder, <a
      href="https://hackclub.com"
      target="_blank">hack clubber</a
    >, and student from New Zealand. Welcome to my <span class="text-xs"
      >(coding)</span
    >corner of the internet!
  </p>
  <p>
    I love coding (especially in C++, Java, and Rust), home labbing / home
    automation, linux, and FOSS! This site is open source <a
      href="https://github.com/Dekoder-py/codingcorner"
      target="_blank">on GitHub</a
    >!
  </p>

  <h2>Contact Me!</h2>

  <p>
    Send me an email! You can find me at: kyle [at] codingcorner [dot] dev! I'd
    love to hear from you!
  </p>

  <h2>Socials</h2>
  <p>
    I'm on <a href="https://github.com/Dekoder-py" target="_blank">GitHub</a>, <a
      href="https://monkeytype.com/profile/dekoder-py"
      target="_blank">Monkeytype</a
    >, and <a href="https://last.fm/user/dekoder-py" target="_blank">last.fm</a
    >.
  </p>

  <h2>Check out some other cool sites!</h2>
  <Webrings />
  <br />
  <Buttons />
</Layout>
