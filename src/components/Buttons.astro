---
import Button88 from "./88Button.astro";
---

<h2>The Buttons</h2>
<div
  id="buttons"
  class="md:grid-cols-[repeat(auto-fit, minmax(88px,1fr))] grid grid-cols-2 place-items-center gap-2 sm:grid-cols-3 md:max-w-[calc(8*88px)]"
>
  <Button88
    url="https://codingcorner.dev"
    src="/buttons/codingcorner.png"
    alt="coding corner"
  />

  <Button88
    url="https://site.slitrostudio.me"
    src="https://site.slitrostudio.me/Slitro2.png"
    alt="Slitro Studio"
  />

  <Button88
    url="https://notoverkill.com"
    src="https://ingo.au/_next/image?url=%2Fbuttons%2Fnotoverkill.gif&w=256&q=75"
    alt="notoverkill"
  />

  <Button88 url="https://poy.ooo" src="/buttons/poyo.png" alt="Poyo" />

  <Button88
    url="https://yaoi.tech/"
    src="https://parakeet.yaoi.tech/button%20(3).gif"
    alt="Alex"
  />

  <Button88
    url="https://gotlobotomy.tech/"
    src="https://ingobeans.github.io/pondering-horses/images/irisbutton.png"
    alt="Iris"
  />

  <Button88
    url="https://errorcodezero.dev/"
    src="https://errorcodezero.dev/button.png"
    alt="ErrorCode0"
  />

  <Button88
    url="https://bomberfish.ca"
    src="https://bomberfish.ca/button.gif"
    alt="BomberFish"
  />

  <Button88 url="https://aconlin.com" src="/buttons/acon.gif" alt="Acon" />

  <Button88 url="http://gideon.sh/" src="/buttons/gideon.gif" alt="Gideon" />

  <Button88
    url="https://www.valen.zip"
    src="https://www.valen.zip/button-bw.gif"
    alt="valen's site's black and white 88x31 button"
  />

  <Button88
    url="https://www.codingcorner.dev"
    src="/buttons/ultrafast.gif"
    alt="Ultrafast Parrot."
  />

  <Button88
    url="https://hack.club"
    src="/buttons/hackclub.gif"
    alt="hack club"
  />

  <Button88 url="https://github.com" src="/buttons/github.gif" alt="github" />

  <Button88
    url="https://catppuccin.com"
    src="/buttons/ctp.webp"
    alt="catppuccin"
  />

  <Button88
    url="https://webmasterwebring.netlify.app"
    src="https://file.garden/ZrZSgsrYfQXsO7QH/ww/btn.png"
    alt="Webmaster Webring"
  />

  <Button88
    url="https://apple.com"
    src="/buttons/macosmade.gif"
    alt="made with macOS"
  />

  <Button88 url="https://neovim.io" src="/buttons/neovim.gif" alt="neovim" />

  <Button88 url="https://www.vim.org" src="/buttons/vim.gif" alt="vim" />

  <Button88
    url="https://home-assistant.io"
    src="/buttons/home-assistant.gif"
    alt="home assistant"
  />

  <Button88 url="https://apple.com" src="/buttons/apple.gif" alt="apple" />

  <Button88
    url="https://notbyai.fyi"
    src="/buttons/notbyai.png"
    alt="not by ai"
  />

  <Button88
    url="https://eightyeightthirty.one/#"
    src="/buttons/88x31.png"
    alt="eighty eight thirty one"
  />

  <Button88
    url="https://anybrowser.org"
    src="/buttons/detect.gif"
    alt="viewable on any browser"
  />
